# Servidor
PORT=3000
NODE_ENV=dev

# Banco de dados (MongoDB Atlas)
# Obtenha em: https://cloud.mongodb.com → Connect → Drivers
DATABASE_URL="mongodb+srv://usuario:senha@cluster.mongodb.net/devbills"

# Firebase Admin SDK (Conta de serviço)
# Obtenha em: Firebase Console → Configurações do projeto → Contas de serviço → Gerar nova chave
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com